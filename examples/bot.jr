## Assignment, values, callable functions, blocks, conditions, and imports.
sys.log("hello world") == greeting
greeting()
sys.add("hello", " world") == message
sys.log(message)
[
  a == "5"
  b == "1"
  sys.log("block ran")
] == routine
sys.log(routine)
routine()
